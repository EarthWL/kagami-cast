#include <windows.h>

// Qt uses the IDI_ICON1 resource as the default window icon as well.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "@APP_DISPLAY_NAME@ contributors"
            VALUE "FileDescription",  "@APP_DISPLAY_NAME@ - AirPlay mirroring receiver"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "KagamiCast"
            VALUE "OriginalFilename", "KagamiCast.exe"
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
            VALUE "ProductName",      "@APP_DISPLAY_NAME@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
